{
  "name": "lineatur",
  "version": "1.1.0",
  "private": true,
  "description": "Lineatur: no-code worksheet editor (block editor -> JSON -> Typst -> PDF / interactive HTML)",
  "license": "MIT",
  "author": "Christian Siegel",
  "homepage": "https://github.com/c-siegel/Lineatur#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c-siegel/Lineatur.git"
  },
  "bugs": {
    "url": "https://github.com/c-siegel/Lineatur/issues"
  },
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "node --test",
    "test:smoke": "node scripts/smoke.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "guide": "node scripts/build-guide.mjs",
    "app": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "org.lineatur.app",
    "productName": "Lineatur",
    "copyright": "MIT License",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "server.js",
      "LICENSE",
      "electron/**",
      "public/**",
      "src/**",
      "fonts/**",
      "samples/**",
      "themes/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Lineatur-${version}-portable.exe"
    }
  }
}
